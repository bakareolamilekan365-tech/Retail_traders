{
  "name": "Retail Traders",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bullseye",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "files.watcherExclude": {
          "**/backend/venv/**": true,
          "**/frontend/node_modules/**": true,
          "**/backend/logs/**": true
        },
        "search.exclude": {
          "**/backend/venv/**": true,
          "**/frontend/node_modules/**": true,
          "**/backend/logs/**": true
        }
      }
    }
  },
  "postCreateCommand": "python -m pip install --upgrade pip && pip install -r backend/requirements.txt && cd frontend && npm install",
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": {
      "label": "Backend",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Frontend",
      "onAutoForward": "notify"
    }
  }
}
